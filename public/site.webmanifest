{
  "name": "actuallyitsnathaniel - Music Producer",
  "short_name": "nathaniel",
  "description": "Professional music producer and audio engineer portfolio",
  "icons": [
    {
      "src": "/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "theme_color": "#000",
  "background_color": "#000",
  "display": "standalone",
  "start_url": "/",
  "scope": "/",
  "file_handlers": [
    {
      "action": "/studio",
      "name": "AIN project",
      "accept": {
        "audio/wav": [".ain"],
        "application/vnd.ain.project+zip": [".ain"]
      },
      "icons": [
        {
          "src": "/icons/ain-file-256.png",
          "sizes": "256x256",
          "type": "image/png"
        },
        {
          "src": "/icons/ain-file.png",
          "sizes": "800x800",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ]
}
